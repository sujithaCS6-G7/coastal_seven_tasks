# Nexora Day 21 AI Focus Backend Local Runtime Environment
DATABASE_URL=postgresql+psycopg2://postgres:Suji%40123@localhost:5432/day10_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
SECRET_KEY=day10-ecommerce-super-secret-jwt-key-2026

# Frontend & CORS
FRONTEND_ORIGIN=http://localhost:5182
ALLOWED_ORIGINS=http://localhost:5182,http://127.0.0.1:5182,http://localhost:5181,http://127.0.0.1:5181,http://localhost:5180,http://127.0.0.1:5180,http://localhost:5179,http://127.0.0.1:5179

# Rate Limiting & Compression
GZIP_MINIMUM_SIZE=500
RATE_LIMIT_AUTH=3/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_CATALOG=180/minute
RATE_LIMIT_SEARCH=90/minute
RATE_LIMIT_TASKS=30/minute
RATE_LIMIT_PROBE=5/minute
RATE_LIMIT_AI=60/minute
RATE_LIMIT_AI_USER=10/minute

# Day 21 Per-User AI Rate Limiting
AI_USER_RATE_LIMIT_COUNT=10
AI_USER_RATE_LIMIT_WINDOW_SECONDS=60
AI_ANON_RATE_LIMIT_COUNT=5

# Day 21 Redis AI Response Caching
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=300
AI_CACHE_PREFIX=ai:cache:v21

# Day 21 Content Moderation & Agent Safety
AI_MODERATION_ENABLED=true
AI_MAX_INPUT_CHARS=1500
AI_AGENT_MAX_ITERATIONS=3

# AI LLM Providers
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
LLM_TERTIARY_PROVIDER=mistral

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

RAG_TOP_K=4
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
