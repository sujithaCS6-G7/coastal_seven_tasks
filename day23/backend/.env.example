# Day 22 Backend Environment Template (.env.example)
ENVIRONMENT=production
FRONTEND_ORIGIN=https://nexora-day22-ai.vercel.app
ALLOWED_ORIGINS=https://nexora-day22-ai.vercel.app,http://localhost:5183,http://127.0.0.1:5183

# Database & Redis (Neon PostgreSQL + Upstash Redis Free Tiers)
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/day10_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Responsible AI & $0 Cost Governance
AI_ZERO_COST_MODE=true
AI_TARGET_SPEND_USD=0.0
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=300
AI_CACHE_PREFIX=ai:cache:v22
AI_USER_RATE_LIMIT_COUNT=10
AI_ANON_RATE_LIMIT_COUNT=5
AI_USER_RATE_LIMIT_WINDOW_SECONDS=60

# Free-Tier LLM Providers ($0 API Spend)
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
LLM_TERTIARY_PROVIDER=mistral
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
