{
  "Description": "AWS Security Group for NexoraAI Production EC2 Instance",
  "GroupName": "sg-nexora-prod",
  "VpcId": "vpc-0123456789abcdef0",
  "IpPermissions": [
    {
      "IpProtocol": "tcp",
      "FromPort": 22,
      "ToPort": 22,
      "IpRanges": [
        {
          "CidrIp": "203.0.113.50/32",
          "Description": "Admin SSH Access from corporate/bastion IP only (Least Privilege)"
        }
      ]
    },
    {
      "IpProtocol": "tcp",
      "FromPort": 80,
      "ToPort": 80,
      "IpRanges": [
        {
          "CidrIp": "0.0.0.0/0",
          "Description": "Public HTTP traffic for Let's Encrypt ACME verification and 301 HTTPS redirect"
        }
      ]
    },
    {
      "IpProtocol": "tcp",
      "FromPort": 443,
      "ToPort": 443,
      "IpRanges": [
        {
          "CidrIp": "0.0.0.0/0",
          "Description": "Public HTTPS TLS 1.3 encrypted production web traffic"
        }
      ]
    }
  ],
  "IpPermissionsEgress": [
    {
      "IpProtocol": "-1",
      "FromPort": -1,
      "ToPort": -1,
      "IpRanges": [
        {
          "CidrIp": "0.0.0.0/0",
          "Description": "Allow all outbound traffic for external AI providers (Gemini, Groq) and Sentry"
        }
      ]
    }
  ]
}
