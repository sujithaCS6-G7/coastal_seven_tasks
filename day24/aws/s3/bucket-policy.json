{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPublicReadForProductCatalogImages",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::nexora-assets-prod/products/*"
    },
    {
      "Sid": "EnforceTLSRequestsOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::nexora-assets-prod",
        "arn:aws:s3:::nexora-assets-prod/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
