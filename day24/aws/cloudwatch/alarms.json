{
  "Alarms": [
    {
      "AlarmName": "Nexora-High-CPU-Utilization-Prod",
      "AlarmDescription": "Triggers when average EC2 CPU exceeds 80% for 2 consecutive 5-minute periods",
      "ActionsEnabled": true,
      "AlarmActions": [
        "arn:aws:sns:us-east-1:123456789012:nexora-devops-critical-alerts"
      ],
      "MetricName": "CPUUtilization",
      "Namespace": "AWS/EC2",
      "Statistic": "Average",
      "Dimensions": [
        {
          "Name": "AutoScalingGroupName",
          "Value": "asg-nexora-backend-prod"
        }
      ],
      "Period": 300,
      "EvaluationPeriods": 2,
      "Threshold": 80.0,
      "ComparisonOperator": "GreaterThanOrEqualToThreshold",
      "TreatMissingData": "missing"
    },
    {
      "AlarmName": "Nexora-High-HTTP-5xx-Error-Rate-Prod",
      "AlarmDescription": "Triggers when ALB HTTP 5XX error count exceeds 25 in 5 minutes",
      "ActionsEnabled": true,
      "AlarmActions": [
        "arn:aws:sns:us-east-1:123456789012:nexora-devops-critical-alerts"
      ],
      "MetricName": "HTTPCode_Target_5XX_Count",
      "Namespace": "AWS/ApplicationELB",
      "Statistic": "Sum",
      "Period": 300,
      "EvaluationPeriods": 1,
      "Threshold": 25.0,
      "ComparisonOperator": "GreaterThanThreshold",
      "TreatMissingData": "notBreaching"
    },
    {
      "AlarmName": "Nexora-Target-Response-Time-High-Prod",
      "AlarmDescription": "Triggers when p95 target response time exceeds 0.5s (500ms)",
      "ActionsEnabled": true,
      "AlarmActions": [
        "arn:aws:sns:us-east-1:123456789012:nexora-devops-critical-alerts"
      ],
      "MetricName": "TargetResponseTime",
      "Namespace": "AWS/ApplicationELB",
      "ExtendedStatistic": "p95",
      "Period": 300,
      "EvaluationPeriods": 2,
      "Threshold": 0.5,
      "ComparisonOperator": "GreaterThanThreshold",
      "TreatMissingData": "notBreaching"
    }
  ]
}
