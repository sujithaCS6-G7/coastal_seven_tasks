# Core Application Settings
ENVIRONMENT=production
APP_NAME="NexoraAI Production E-Commerce Store"
VERSION=23.0.0
DEBUG=false
SECRET_KEY=nexora-jwt-secret-replace-with-64-character-random-key-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# PostgreSQL Database (Docker Service DNS: postgres)
POSTGRES_DB=day10_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/day10_db

# Redis Cache & Message Broker (Docker Service DNS: redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Celery Task Queues & Result Backends
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Frontend Origins & CORS Policy
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80,http://127.0.0.1:80

# Rate Limiting & OWASP Security
GZIP_MINIMUM_SIZE=500
RATE_LIMIT_AUTH=3/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_CATALOG=180/minute
RATE_LIMIT_SEARCH=90/minute
RATE_LIMIT_TASKS=30/minute
RATE_LIMIT_PROBE=5/minute
RATE_LIMIT_AI=60/minute
RATE_LIMIT_AI_USER=10/minute

# Day 22/23 Responsible AI & $0 Cost Governance (Default: Free Tier Fallbacks)
AI_ZERO_COST_MODE=true
AI_TARGET_SPEND_USD=0.0
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=300
AI_MODERATION_ENABLED=true

# LLM Providers (Free Tier Fallbacks active)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
