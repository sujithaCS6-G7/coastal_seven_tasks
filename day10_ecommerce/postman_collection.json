			"name": "5. Orders & Checkout",
			"item": [
				{
					"name": "POST Checkout Cart & Place Order",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Ensure cart has an active line item before checking out",
									"pm.sendRequest({",
									"    url: pm.collectionVariables.get(\"baseUrl\") + \"/cart/items\",",
									"    method: \"POST\",",
									"    header: {",
