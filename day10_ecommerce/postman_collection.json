		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "productId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "orderId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "tempUser",
			"value": "customer_auto",
			"type": "string"
		},
		{
			"key": "tempEmail",
			"value": "customer_auto@example.com",
			"type": "string"
		}
