APP_NAME="Nexora Day 17 Full-Stack & Real-Time E-Commerce API"
VERSION="17.0.0"
DEBUG=True

# CORS & Frontend Origin Configuration
FRONTEND_ORIGIN="http://localhost:5177"
ALLOWED_ORIGINS="http://localhost:5177,http://127.0.0.1:5177,http://localhost:5173,http://127.0.0.1:5173"

# Database (PostgreSQL)
DATABASE_URL="postgresql+psycopg2://postgres:your_password@localhost:5432/day10_db"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# Celery
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Security & JWT (Replace SECRET_KEY in production)
SECRET_KEY="replace-with-strong-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Uploads
UPLOAD_DIR="uploads/products"
MAX_FILE_SIZE_BYTES=5242880

# Caching & Cart TTL
CART_TTL_SECONDS=86400
PRODUCT_CACHE_TTL_SECONDS=300
