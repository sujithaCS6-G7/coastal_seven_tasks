# Nexora Day 20 AI Backend Environment Variables
DATABASE_URL=postgresql+psycopg2://postgres:Suji%40123@localhost:5432/day10_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
SECRET_KEY=day20-ai-rag-langchain-super-secret-jwt-key-2026

# Frontend & CORS
FRONTEND_ORIGIN=http://localhost:5181
ALLOWED_ORIGINS=http://localhost:5181,http://127.0.0.1:5181,http://localhost:5180,http://127.0.0.1:5180,http://localhost:5179,http://127.0.0.1:5179

# Rate Limiting & Compression
GZIP_MINIMUM_SIZE=500
RATE_LIMIT_AUTH=3/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_CATALOG=180/minute
RATE_LIMIT_SEARCH=90/minute
RATE_LIMIT_TASKS=30/minute
RATE_LIMIT_PROBE=5/minute
RATE_LIMIT_AI=60/minute

# AI LLM Providers (Configure primary and fallback hierarchy)
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
LLM_TERTIARY_PROVIDER=mistral

# Groq (Free Tier: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini (Free Tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Mistral AI (Free Tier: https://console.mistral.ai/)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# OpenAI-Compatible Fallback / Custom (e.g. Local Ollama or OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# RAG & ChromaDB
RAG_TOP_K=4
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
