APP_NAME="Nexora Day 19 Security, Compression & Performance API"
VERSION="19.0.0"
DEBUG=True

# CORS & Frontend Origin Configuration (Day 18 Port 5179)
FRONTEND_ORIGIN="http://localhost:5180"
ALLOWED_ORIGINS="http://localhost:5180,http://127.0.0.1:5180,http://localhost:5179,http://127.0.0.1:5179,http://localhost:5177,http://127.0.0.1:5177,http://localhost:5175,http://127.0.0.1:5175"

# Database (PostgreSQL day10_db in pgAdmin)
DATABASE_URL="postgresql+psycopg2://postgres:Suji%40123@localhost:5432/day10_db"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# Celery
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Security & JWT
SECRET_KEY="day10-ecommerce-super-secret-jwt-key-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Uploads
UPLOAD_DIR="uploads/products"
MAX_FILE_SIZE_BYTES=5242880

# Caching & Cart TTL
CART_TTL_SECONDS=86400
PRODUCT_CACHE_TTL_SECONDS=300
